# ── Frontend (Vercel) ──
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_WORKER_URL=https://your-worker-url.com

# ── Worker only. Never put these in a VITE_ variable. ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# Encrypts SMTP/IMAP passwords and signs tracking links. Generate once and keep safe:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes every stored mail password unreadable.
SECRETS_KEY=

# Public URL of this worker: used in tracking and unsubscribe links
PUBLIC_WORKER_URL=https://your-worker-url.com
# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=https://your-site.vercel.app,http://localhost:5173

# AI features (optional). Without it the AI buttons report "not configured".
ANTHROPIC_API_KEY=

# Worker tuning (optional)
POLL_INTERVAL=10000
BATCH_SIZE=100
DELAY_BETWEEN_BATCHES=2000
